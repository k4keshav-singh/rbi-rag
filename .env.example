# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# --- Postgres (must match docker-compose.yml) ---
POSTGRES_HOST=localhost
# Host port for the container. Deliberately not 5432: a locally installed
# Postgres usually holds that port and would answer instead.
POSTGRES_PORT=5434
POSTGRES_USER=rbi
POSTGRES_PASSWORD=rbi
POSTGRES_DB=rbi_rag

# --- Anthropic ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=8192
# low | medium | high | xhigh | max. Untuned; Phase 4 should sweep it.
ANTHROPIC_EFFORT=medium

# --- Local models (downloaded on first use, cached under HF_HOME) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Ingestion ---
# Seconds to wait between requests to rbi.org.in. Do not lower this.
DOWNLOAD_DELAY_SECONDS=2.0
DOWNLOAD_MAX_RETRIES=5
USER_AGENT=rbi-rag/0.1 (+https://github.com/USERNAME/rbi-rag)
LISTING_URL=https://www.rbi.org.in/Scripts/BS_ViewMasDirections.aspx

# --- Chunking (Phase 4 sweeps these; these are the defaults) ---
CHUNK_STRATEGY=section_aware
CHUNK_SIZE=512
CHUNK_OVERLAP_RATIO=0.15

# --- Evaluation ---
# Judge model for faithfulness. Empty falls back to ANTHROPIC_MODEL.
JUDGE_MODEL=
EVAL_CACHE_ENABLED=true

# --- Paths (relative to the repo root unless absolute) ---
DATA_DIR=data
RESULTS_DIR=results
EVAL_DIR=eval

# --- Retrieval defaults (overridable per request / per ablation run) ---
RETRIEVER=hybrid
TOP_K=10
RRF_K=60
RERANK_ENABLED=true
# Retrieval gate for abstention. Empty disables it, which is the default
# until Phase 4 can tune it on labelled unanswerable questions. Compared
# against the reranker score, or top dense cosine; never against RRF.
ABSTAIN_MIN_SCORE=

# --- Logging ---
LOG_LEVEL=INFO
